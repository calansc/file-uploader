<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <a href=/sharedLink/<%= shareLink.token %>>shared link</a>
    <%= shareLink.token %>
    <br>
    <div>Expires in:</div>
    <% let now = new Date(); %>
    <% let diffMs = shareLink.expiresAt - now; %>
    <% let diffHrs = Math.floor(diffMs / 3600000); %>
    <%= diffHrs %> hours
    <br>
    <div>Expiration Date:</div>
    <%= shareLink.expiresAt %>
</body>
</html>