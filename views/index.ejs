<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <% if(locals.success) {%>
        <div><%= success %></div>
    <% } %>
        <% if(locals.error) {%>
        <div><%= error %></div>
    <% } %>
    <% if (locals.user) {%>
        <h1>Welcome, <%= user.username %>!</h1>
        <form action="/logout" method="GET">
            <button type="submit">Logout</button>
        </form>
        <div>
            <h2>Folders: -- left bar</h2>
            <form action="/newFolder" method="POST">
                <label for="folderName"></label>
                <input type="text" id="folderName" name="folderName" placeholder="New Folder Name" required>
                <button type="submit">Create Folder</button>
            </form>
            <div>Folder list here -- folder list on left?</div>
            <div>
                <% folders.forEach(folder => { %>
                    <form action="/folder/<%= folder.id %>" method="GET" style="display: inline;">
                        <button type="submit"><%= folder.name %></button>
                    </form>
                <% }); %>
            </div>
        </div>
        <div>
            <% if (selectedFolder) { %>
            <h2>Current Folder: <%= selectedFolder.name %></h2>
            <form action="/share/folder/<%= selectedFolder.id %>" method="GET" style="display: inline;">
                <button type="submit">Share Folder</button>
            </form>
            <form action="/edit/<%= selectedFolder.id %>" method="GET" style="display: inline;">
                <button type="submit">Edit Folder</button>
            </form>
            <form action="/delete/folder/<%= selectedFolder.id %>" method="GET" style="display: inline;">
                <button type="submit">Delete Folder</button>
            </form>
            <div>Files in selected folder -- main area
                <form action="/upload/<%= selectedFolder.id %>" method="POST" enctype="multipart/form-data">
                    <label for="fileUpload">Upload File:</label>
                    <input type="file" id="fileUpload" name="fileUpload" required>
                    <button type="submit">Upload</button>
                </form>
                <div>
                    <% if (selectedFolder.files && selectedFolder.files.length > 0) { %>
                        <ul>
                            <% selectedFolder.files.forEach(file => { %>
                                <li>
                                    <a href="/files/<%= file.id %>"><%= file.fileName %></a>
                                    <form action="/share/file/<%= file.id %>" method="GET" style="display: inline;">
                                        <button type="submit">Share</button>
                                    </form>
                                    <form action="/delete/file/<%= file.id %>" method="GET" style="display: inline;">
                                        <button type="submit">Delete</button>
                                    </form>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <p>No files in this folder.</p>
                    <% } %>
                </div>
            </div>
            <% } else { %>
            <h2>No Folder Selected</h2>
            <% } %>
        </div>
    <% } else { %>
         <h1>Hello File Uploaders!</h1>
        <h3>Please login to upload and access files:</h3>
        <form action="/login" method="POST">
            <label for="username">Username:</label>
            <input type="text" id="username" name="username" required>
            <br>
            <label for="password">Password:</label>
            <input type="password" id="password" name="password" required>
            <br>
            <button type="submit">Login</button>
        </form>
        <h3>Not a member yet?</h3>
        <form action="/register" method="GET">
            <button type="submit">Register Here</button>
        </form>
    <% } %>
</body>
</html>